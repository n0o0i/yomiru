# サーバー設定
PORT=3000
NODE_ENV=development

# Google Books API設定
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# データベース設定（将来の実装用）
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=yomiru
# DB_USER=your_username
# DB_PASSWORD=your_password

# JWT設定（認証機能用）
# JWT_SECRET=your_jwt_secret_key
# JWT_EXPIRES_IN=7d

# CORS設定
# CORS_ORIGIN=http://localhost:3000
